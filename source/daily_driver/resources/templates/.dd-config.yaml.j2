#         hn_max_posts: 500
#       greenhouse:            # Greenhouse boards
#         enabled: false
#         # Boards always scraped: <slug> in boards.greenhouse.io/<slug>.
#         greenhouse_boards: []
#         # Boards never scraped. Case matters.
#         exclude_boards: []
#       ashby:            # Ashby boards
#         enabled: false
#         # Boards always scraped: <slug> in jobs.ashbyhq.com/<slug>. Case matters.
#         ashby_boards: []
#         # Boards never scraped. Case matters.
#         exclude_boards: []
#       lever:            # Lever boards
