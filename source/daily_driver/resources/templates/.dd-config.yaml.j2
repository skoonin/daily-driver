# daily-driver settings
#
# How to edit:
# - A setting is one word, a colon, and a value, such as "model: sonnet".
#   Notes are sentences.
# - A setting that starts with "# " is off. Delete the "# " to turn it on.
#   Leave the "# " on notes.
# - A setting indented under a heading (such as "focus:") also needs that
#   heading turned on.
# - Some optional settings start with "# " twice, such as "#   # model:".
#   After you turn on their section, delete the second "# " too.
# - Keep the spaces at the start of each line. They show what belongs where.
# - Run `daily-driver doctor` after editing to check for mistakes.
#
# Write about yourself and your recurring tasks in context.md, not here.
# Every setting is described at
# https://github.com/skoonin/daily-driver/blob/main/docs/configuration.md

daily_driver:
  # Folder for the tracker, notes, and other files. "." means this folder.
  output_dir: .

# Your task list.
tracker:
  # Category shown as the default by `daily-driver help categories`.
  # It must be one of the categories below.
  default_category: task
  # Categories, each with the fields a new entry must have.
  # The fields are title, link, tags, notes, due, next_action, or an --extra
  # name.
  categories:
    task:
      required: [title]
    # errand:
    #   required: [title]
    # ticket:
    #   required: [title, link]
  # Turn this line on to stop warnings for unusual statuses.
  # Usual statuses: open, in-progress, blocked, done, ruled-out.
  # warn_unknown_status: false
  # Your own statuses. These do not cause the warning.
{% if "job_search" in plugins %}
  # Job entries still warn: they have their own list of statuses.
{% endif %}
  # extra_statuses: [waiting, snoozed]
  # More statuses that close an entry, added to done, ruled-out, dropped,
  # rejected, and closed. Closed entries get no follow-ups.
  # terminal_statuses: [cancelled]

# When your day starts and ends. `daily-driver scheduler install` then shows
# a reminder at each time: click it to start day-start or day-end, or run
# the command it shows. Clicking needs terminal-notifier; install it with
# `brew install terminal-notifier`. With this section off, there are no
# day-start or day-end reminders.
# A day-start more than 2 hours after day_start is a late start: Claude plans
# only the rest of the day. With this section off, after 11:00 is late.
# Times are 24-hour "HH:MM" in quotes.
# Days are "daily", "weekdays", or a list such as [mon, wed, fri].
# schedule:
#   day_start: "08:00"
#   day_end: "17:30"
#   days: daily

# More timed runs from `daily-driver scheduler install`. These run at the
# times shown even while this section is off. To change a part, turn on all
# of its lines: a part you turn on replaces its times and days completely.
# Parts you leave off keep these times. Times and days work as in "schedule".
# scheduler:
#   # Check-in reminders.
#   checkin:
#     times: ["11:00", "15:00"]
#     days: daily
{% if "job_search" in plugins %}
#
#   # Job search (`jobs run`).
#   jobs:
#     time: "07:00"
#     days: daily
#
#   # Search for new company job boards (`jobs discover-boards`).
#   discovery:
#     time: "23:59"
#     days: [sat, tue]
{% endif %}

# Focus mode (`focus on`) pauses check-in reminders.
# focus:
#   # Length when `focus on` has no --for, for example "25m" or "1h".
#   default_duration: "25m"

# check-in continues your last Claude session instead of starting a new one.
# claude:
#   resume_check_in: true

# Copies your plan's time blocks into the macOS Calendar app
# (`calendar sync`).
# calendar:
#   sync_enabled: true
#   # Create this calendar in the Calendar app first.
#   plan_calendar_name: "Daily Plan"

# Folders that hold your git projects, so Claude can see your recent work.
# gather:
#   git:
#     search_paths: ["~/git"]

# Which AI runs each feature. Leave this off to use Claude for everything.
# Claude models are sonnet, opus, and haiku. Ollama runs AI on your computer;
# its models have names such as "qwen2.5:14b".
# To set up Ollama, see
# https://github.com/skoonin/daily-driver/blob/main/docs/ollama-setup.md
# ai:
#   # Which AI runs summary and voice-update, claude or ollama.
{% if "job_search" in plugins %}
#   # Job search uses it too, unless set under job_search below.
{% endif %}
#   provider: claude
#   # Model for those features. It must match the provider.
#   # model: sonnet
#
#   # Model for day-start, check-in, and day-end. These always use Claude.
#   # --model on the command line overrides it.
#   interactive:
#     model: sonnet
#
#   # Use a different AI for one feature only.
#   # summary:
#   #   provider: ollama
#   #   model: "qwen2.5:14b"
#   # voice_update:
#   #   provider: claude
#   #   model: opus
#
#   ollama:
#     # Address of the Ollama app.
#     endpoint: "http://localhost:11434"
#     # Seconds to wait for an answer.
#     timeout: 60
{% if "job_search" in plugins %}
#     # How many job reviews run at the same time.
#     max_parallel: 4
#
#   claude:
#     # How many job reviews run at the same time.
#     max_parallel: 4
{% endif %}
{% if plugins %}

# Add-ons. Only "enabled" is on; turn on any other setting to change it.
plugins:
{% if "job_search" in plugins %}
  # Job search: `daily-driver jobs`. Found jobs go to jobs.csv.
  job_search:
    # false turns job search off and keeps these settings.
    enabled: true
#     # Who you are as a candidate. The AI uses it to score each job.
#     persona: "Senior SRE / Platform Engineer"
#     # Job titles to keep. "*" matches anything; a leading "!" rules a
#     # title out.
#     roles: []  # for example ["SRE", "Platform Engineer", "!Manager"]
#     # A title is also kept when it has a word from each list below.
#     # Left empty, built-in SRE and infrastructure words are used; listing
#     # words replaces them.
#     domain_keywords: []  # for example ["kubernetes", "observability"]
#     seniority_keywords: []  # for example ["senior", "staff", "principal"]
#
#     locations:
#       # Your city. The AI uses it to score each job. Left out, it is
#       # Vancouver, BC.
#       home_city: "Vancouver, BC"
#       # Keep remote jobs.
#       remote: true
#       # Countries to search, by 2-letter code, each with a list of cities.
#       # [] means the whole country; listing cities keeps only those.
#       countries:
#         CA: [Vancouver, Victoria]
#         US: []
#       # true keeps remote jobs from any country, not only those above.
#       remote_unlisted_countries: false
#
#     scraper:
#       # Turns on `jobs run`. It finds nothing while this is off.
#       enabled: true
#       # Search words for LinkedIn, Indeed, and Apple. Left empty, they
#       # come from roles.
#       search_terms: []  # for example ["SRE", "Platform Engineer"]
#       # Skip Hacker News job posts (hn_jobs below) older than this many
#       # days. 0 means no limit.
#       max_age_days: 30
#       # Result pages read per Apple search.
#       max_pages: 3
#       # Seconds to wait for a site.
#       timeout: 30
#       # Retries when a site is busy. 0 means no retries.
#       max_retries: 3
#       # Sites searched at the same time.
#       parallel_workers: 8
#       # Browser for Apple: firefox, chromium, or webkit.
#       # Install it once with `playwright install firefox`.
#       browser: firefox
#       # How daily-driver identifies itself to job sites.
#       user_agent: "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:128.0) Gecko/20100101 Firefox/128.0"
#       # Words ignored when matching the same company from two sites.
#       # Left empty, a built-in list is used (inc, llc, ltd, corp, gmbh,
#       # labs, technologies, and more); listing words replaces it.
#       company_noise_words: []  # for example ["inc", "ltd", "labs"]
#
#     # AI review of each new job: one AI call per job.
#     enrichment:
#       # Score each job 1-10 for fit.
#       enrich_fit: true
#       # Add a one-line note: tech stack, remote, red flags.
#       enrich_notes: true
#       # Label each job remote, hybrid, or onsite.
#       enrich_is_remote: true
#       # Most jobs reviewed per run.
#       max_enrich_fit: 50
#       # Your own questions, answered for each job in its note.
#       criteria:
#         - label: Sponsorship
#           assess: "Does the role offer visa sponsorship?"
#       # AI for job reviews: claude or ollama, and its model. Left out, the
#       # ai section decides.
#       # provider: claude
#       # model: sonnet
#       # fit_notes also sets the AI for job reviews, and wins over the two
#       # lines above.
#       # fit_notes:
#       #   provider: ollama
#       #   model: "qwen2.5:7b"
#       # Seconds before one review gives up.
#       enrich_timeout: 30
#       # Words of each posting the AI reads. Pay and visa details are often
#       # near the end, so a low number can miss them.
#       max_description_words: 2000
#       # With `jobs backfill --force-update`, skip jobs reviewed within
#       # this many hours. 0 redoes all; "missing" does only unreviewed jobs.
#       force_recook_cooldown_hours: 24
#       # Seconds to pause between job page downloads.
#       detail_delay_seconds: 0.5
#
#     # `jobs verify`: closes saved jobs that are no longer posted.
#     verify:
#       # Re-check a job's link after this many days.
#       reverify_days: 7
#       # Close jobs with no link to check (Indeed, Hacker News) after this
#       # many days.
#       unverified_age_days: 30
#
#     # `jobs discover-boards`: finds company job boards with matching jobs.
#     discovery:
#       # Re-check a known board after this many days.
#       reprobe_days: 30
#       # Most boards re-checked per run.
#       max_reprobe_per_sweep: 500
#       # Report a site as failing when this share of its boards fail
#       # (0.25 = 25%).
#       degraded_failure_ratio: 0.25
#       # Re-check a board less often after this many empty checks in a row.
#       # 0 turns this off.
#       dormant_after_empty_sweeps: 2
#       # How much less often: 6 turns every 30 days into every 180.
#       dormant_reprobe_multiplier: 6
#
#     # Sites to search. Only sites listed here run; true or false turns
#     # a site on or off.
#     sources:
#       linkedin:
#         enabled: true
#         # Results per search.
#         results_wanted_per_query: 50
#         # Skip jobs older than this many hours (168 = 7 days).
#         hours_old: 168
#         # Most city-by-city searches per run.
#         max_city_queries: 40
#       indeed:
#         enabled: true
#         results_wanted_per_query: 50
#         hours_old: 168
#         max_city_queries: 40
#         # Indeed site to use when one of your countries has no Indeed site.
#         country: USA
#       # jobs.apple.com. Needs the browser set under scraper above.
#       apple: false
#       # Hacker News monthly "Who is hiring?" thread.
#       hn_who_is_hiring:
#         enabled: false
#         # Most posts read.
#         hn_max_posts: 500
#       # Hacker News job posts from Y Combinator companies.
#       hn_jobs:
#         enabled: false
#         hn_max_posts: 500
#       # remoteok.com. Tags add matching jobs to the main feed.
#       remoteok:
#         enabled: false
#         remoteok_tags: [devops, kubernetes, aws]
#       # weworkremotely.com. Needs at least one category.
#       weworkremotely:
#         enabled: false
#         wwr_categories: [devops-sysadmin]
#       # Company job boards on Greenhouse, Ashby, and Lever. Name a company
#       # as it appears in its board link, for example "acme" for
