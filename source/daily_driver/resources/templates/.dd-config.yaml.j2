#       force_recook_cooldown_hours: 24
#       # Seconds between posting page fetches.
#       detail_delay_seconds: 0.5
#       # Questions asked of each posting. Each adds "Label: answer" to Notes.
#       criteria:
#         - label: Sponsorship
#           assess: "Does the role offer visa sponsorship?"
#
#     # `jobs verify`: closes postings that are gone.
#     verify:
#       # Re-check a posting's link after this many days.
#       reverify_days: 7
#       # Close postings with no checkable link after this many days.
#       unverified_age_days: 30
#
#     # `jobs discover-boards`: finds company job boards.
#     discovery:
#       # Re-check a known board after this many days.
#       reprobe_days: 30
#       # Most boards re-checked per sweep, most overdue first.
#       max_reprobe_per_sweep: 500
#       # Share of a platform's boards that must fail to report it degraded.
#       degraded_failure_ratio: 0.25
#       # Empty checks in a row before a board is checked less often. 0 disables.
#       dormant_after_empty_sweeps: 2
#       # A dormant board is re-checked every reprobe_days x this.
#       dormant_reprobe_multiplier: 6
#     sources:
#
#       # Only listed sources run. Inside a source, a key left out
#       # uses its default.
#       remoteok:            # remoteok.com
#         enabled: false
#         # Tags searched as well as the main feed.
#         remoteok_tags: [devops, kubernetes, aws]
