#       search_terms: null
#       # Sources scraped at the same time.
#       parallel_workers: 8
#       # Result pages read per Apple search term.
#       max_pages: 3
#       # Browser for Apple: firefox, chromium or webkit. Install it with
#       # `playwright install <browser>`.
#       browser: firefox
#
#     # AI pass that scores fit and writes Notes. Costs API calls.
#     enrichment:
#       # claude or ollama. Unset uses `ai.provider`.
#       provider: claude
#       # Model for enrichment. Unset uses `ai.model`.
#       # model: sonnet
