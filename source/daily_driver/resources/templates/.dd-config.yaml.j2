# daily-driver settings
#
# - Each value below is the default. Change a value to change how
#   daily-driver works. If you remove a setting, its default applies.
# - A setting that starts with "# " is a sample. To use it, delete the "# ".
# - Run `daily-driver doctor` after you edit this file.
#
# All settings: https://github.com/skoonin/daily-driver/blob/main/docs/configuration.md
# Put notes about yourself and your recurring tasks in context.md, not here.

# Which AI runs each feature. To use opencode, LM Studio, Ollama, or another
# model, see https://github.com/skoonin/daily-driver/blob/main/docs/configuration.md#ai
ai:
  interactive:
    resume_check_in: false  # true: check-in continues your last chat
  providers:
    claude:
      # model: sonnet  # default: the Claude Code model
      # timeout: 600  # seconds; default: 180 for text tasks, 900 for agent tasks
{% if "job_search" in plugins %}
      max_parallel: 4  # job reviews at the same time
{% endif %}
      tasks: [interactive, summary, voice_update]
      # The shipped commands. Leave them off so that updates reach you.
      # session_id: "{uuid}"
      # run: ["claude", ["--agent", "{agent}"], ["-n", "{session_name}"], ["--session-id", "{session_id}"], ["--model", "{model}"], ["{command}"], "--add-dir", "{workspace}"]
      # resume: ["claude", ["--agent", "{agent}"], ["-n", "{session_name}"], "--resume", "{session_id}", ["--model", "{model}"], ["{command}"], "--add-dir", "{workspace}"]
      # agent: ["claude", "-p", "--no-session-persistence", ["--model", "{model}"], "--add-dir", "{workspace}"]
      # text: ["claude", "-p", "--no-session-persistence", "--safe-mode", ["--model", "{model}"], ["--system-prompt", "{system}"]]
    # A provider of your own starts from the settings of its parent provider.
    # To use it, move a task from the claude list to its own tasks list.
    # claude-sonnet:
    #   parent_provider: claude
    #   model: sonnet
    # opencode reads the model of a chat from a JSON file in this folder.
    # opencode:
    #   model: anthropic/claude-sonnet-5-5
    #   model_file: {path: opencode.json, key: model}
    #   cleanup: ["opencode", "session", "delete", "{session_id}"]  # runs after each call
    # A model server on this computer, such as LM Studio.
    # my-server:
    #   base_url: http://localhost:1234/v1
    #   model: qwen3-coder

# Copy your plan's time blocks into macOS Calendar (`calendar sync`).
calendar:
  sync_enabled: false
  plan_calendar_name: "Daily Plan"  # create it in Calendar first

# Length of `focus on` without --for.
focus:
  default_duration: "25m"

# Folders with your git projects, such as ["~/git"].
gather:
  git:
    search_paths: []

# Day-start and day-end reminders. Write times in quotes.
schedule:
  # day_start: "08:00"  # default: no reminder; a day-start after 11:00 is late
  # day_end: "17:30"  # default: no reminder
  days: daily  # daily, weekdays, or a list such as [mon, wed, fri]

# Other reminders. Run `daily-driver scheduler install` after a change.
scheduler:
  checkin:
    enabled: true
    times: ["11:00", "15:00"]
    days: daily

# Your task list.
tracker:
  default_category: task
  # Each category names the fields that a new entry must have: title, link,
  # notes, next_action, due, status, tags, or the name of an --extra key.
  categories:
    task:
      required: [title]
  # Built-in statuses: open, in-progress, blocked, done, ruled-out.
  # These close an entry: done, ruled-out, dropped, rejected, closed.
{% if "job_search" in plugins %}
  # Job entries use found, pending, skipped, applied, interviewing, rejected,
  # dropped, and closed.
{% endif %}
  warn_unknown_status: true  # warn when a status is not built in
  extra_statuses: []  # your own statuses; they never cause the warning
  terminal_statuses: []  # your own statuses that close an entry
{% if plugins %}

plugins:
{% if "job_search" in plugins %}
  # Job search (`daily-driver jobs`). All settings:
  # https://github.com/skoonin/daily-driver/blob/main/docs/job-search.md
  job_search:
    enabled: true  # false turns job search off and keeps these settings
    # provider: opencode  # AI for job reviews; default: claude
    tasks: {}  # AI for one task, such as {fit_notes: lmstudio}
    roles: []  # job titles to keep, such as ["SRE", "!Manager"]
    domain_keywords: []  # empty: built-in words
    seniority_keywords: []  # empty: built-in words
    # Places to keep. With no locations block, jobs from every place are kept.
    # locations:
    #   home_city: "Vancouver, BC"
    #   remote: true
    #   countries:  # 2-letter codes; [] means the whole country
    #     CA: [Vancouver, Victoria]
    #     US: []
    #   remote_unlisted_countries: false
    scraper:
      enabled: false  # true turns on `jobs run`
      # search_terms: ["platform engineer"]  # default: your roles
      max_age_days: 30
      max_pages: 3
      timeout: 30
      max_retries: 3
      parallel_workers: 8
      browser: firefox
      user_agent: "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:128.0) Gecko/20100101 Firefox/128.0"
      company_noise_words: []  # empty: built-in words
    # AI review of each new job.
    enrichment:
      enrich_fit: true
      enrich_notes: true
      enrich_is_remote: true
      max_enrich_fit: 50
      enrich_timeout: 30
      max_description_words: 2000
      force_recook_cooldown_hours: 24
      detail_delay_seconds: 0.5
      # Your own questions, answered for each job.
      # criteria:
      #   - label: Sponsorship
      #     assess: "Does the role offer visa sponsorship?"
    verify:
      reverify_days: 7
      unverified_age_days: 30
    discovery:
      reprobe_days: 30
      max_reprobe_per_sweep: 500
      degraded_failure_ratio: 0.25
      dormant_after_empty_sweeps: 2
      dormant_reprobe_multiplier: 6
    # When `jobs run` and `jobs discover-boards` run in the background. Run
    # `daily-driver scheduler install` after a change.
    scheduler:
      run:
        enabled: true
        time: "07:00"
        days: daily
      discovery:
        enabled: true
        time: "23:59"
        days: [sat, tue]
    # Sites to search. No site is searched until you list it here.
    # sources:
    #   linkedin:
    #     enabled: true
    #     results_wanted_per_query: 50
    #     hours_old: 168
    #     max_city_queries: 40
    #   indeed:
    #     enabled: true
    #     results_wanted_per_query: 50
    #     hours_old: 168
    #     max_city_queries: 40
    #     country: USA
    #   apple: true
    #   hn_who_is_hiring:
    #     enabled: true
    #     hn_max_posts: 500
    #   hn_jobs:
    #     enabled: true
    #     hn_max_posts: 500
    #   remoteok:
    #     enabled: true
    #     remoteok_tags: [devops, kubernetes, aws]
    #   weworkremotely:
    #     enabled: true
    #     wwr_categories: [devops-sysadmin]
    #   greenhouse:
    #     enabled: true
    #     greenhouse_boards: []  # boards.greenhouse.io/<name>
    #     exclude_boards: []
    #   ashby:
    #     enabled: true
    #     ashby_boards: []  # jobs.ashbyhq.com/<name>
    #     exclude_boards: []
    #   lever:
    #     enabled: true
    #     lever_boards: []  # jobs.lever.co/<name>
    #     exclude_boards: []
    #   workable:
    #     enabled: true
    #     workable_accounts: []  # apply.workable.com/<name>
    #   workday:
    #     enabled: true
