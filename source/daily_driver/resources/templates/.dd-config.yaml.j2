# daily-driver settings
#
# - Each value below is the default. Change a value to change how
#   daily-driver works. If you remove a setting, its default applies.
# - A setting that starts with "# " is a sample. To use it, delete the "# ".
# - Run `daily-driver doctor` after you edit this file.
#
# All settings: https://github.com/skoonin/daily-driver/blob/main/docs/configuration.md
# Put notes about yourself and your recurring tasks in context.md, not here.

# Which AI runs each feature. To use opencode, LM Studio, Ollama, or another
# model, see https://github.com/skoonin/daily-driver/blob/main/docs/providers.md
ai:
  interactive:
    resume_check_in: false  # true: check-in continues your last chat
  providers:
    claude:
      # model: sonnet  # default: the Claude Code model
      # timeout: 600  # seconds; default: 180 for text tasks, 900 for agent tasks
{% if "job_search" in plugins %}
      # job reviews use enrichment.enrich_timeout instead
{% endif %}
      tasks: [interactive, summary, voice_update]
    # Your own provider: move a task from the claude list to its tasks list.
    # claude-sonnet:
    #   parent_provider: claude
    #   model: sonnet
    # opencode:
    #   model: anthropic/claude-sonnet-5-5
    #   model_file: {path: opencode.json, key: model}
    #   cleanup: ["opencode", "session", "delete", "{session_id}"]  # runs after each call
    # my-server:
    #   base_url: http://localhost:1234/v1
    #   model: qwen3-coder

# Copy your plan's time blocks into macOS Calendar (`calendar sync`).
calendar:
  sync_enabled: false
  plan_calendar_name: "Daily Plan"  # create it in Calendar first

# Length of `focus on` without --for.
focus:
  default_duration: "25m"

# Folders with your git projects, such as ["~/git"].
gather:
  git:
    search_paths: []

# Day-start and day-end reminders. Write times in quotes.
# Run `daily-driver scheduler install` after a change.
schedule:
  # day_start: "08:00"  # default: no reminder; a day-start after 11:00 is late
  # day_end: "17:30"  # default: no reminder
  days: daily  # daily, weekdays, or a list such as [mon, wed, fri]

# Check-in reminders. Run `daily-driver scheduler install` after a change.
scheduler:
  checkin:
    enabled: true
    times: ["11:00", "15:00"]
    days: daily  # daily, weekdays, or a list such as [mon, wed, fri]

# Your task list.
tracker:
  default_category: task
  # Each category names the fields that a new entry must have: title, link,
  # notes, next_action, due, status, tags, or the name of an --extra key.
  categories:
    task:
      required: [title]

  # Built-in statuses: open, in-progress, blocked, done, ruled-out.
  # These close an entry: done, ruled-out, dropped, rejected, closed.
{% if "job_search" in plugins %}
  # Job entries use found, pending, skipped, applied, interviewing, rejected,
  # dropped, and closed.
{% endif %}
  extra_statuses: []  # your own statuses; ones not listed here display a warning
  terminal_statuses: []  # your own closing statuses
{% if plugins %}

plugins:
{% if "job_search" in plugins %}

  # Job search (`daily-driver jobs`). All settings:
  # https://github.com/skoonin/daily-driver/blob/main/docs/job-search.md

  job_search:
    enabled: true
    tasks:
      fit_notes: claude  # Provider that scores each job and writes its note
    # Job titles to search for and keep. A leading "!" drops a title.
    roles: []  # ["SRE", "!Manager"]
    domain_keywords: []  # words for your field, ["aws", "observability"]
    seniority_keywords: []  # job levels to keep, such as ["senior"]
    # home_city: "Portland, OR"  # the AI review scores jobs in your city higher

    # Places to keep. With no locations block, jobs from every place are kept.
    # locations:
    #   countries:  # 2-letter country codes, each with a list of cities
    #     CA: [Vancouver, Victoria]
    #     US: []  # empty: the whole country
    #   remote: true  # false: drop remote jobs
    #   remote_unlisted_countries: false  # true: also keep remote jobs in other countries

    # How job sites are read. These settings apply to every site.
    scraper:
      search_terms: []  # words to search for, added to your roles
      max_age_days: 7  # skip jobs posted longer ago (Hacker News jobs, LinkedIn, Indeed); 0: no limit
      max_results: 50  # most jobs per search on LinkedIn, Indeed, and Apple
      timeout: 30  # seconds to wait for a site to respond before moving on
      max_retries: 3  # retries when a site is busy
      max_parallel: 4  # sites searched at the same time
      company_noise_words: []  # words ignored to match company names, ["inc", "ltd"]

    # The AI review of each new job.
    enrichment:
      enabled: true  # fit score, note, and remote label for each job; false: no review
      max_enrich_fit: 50  # most jobs reviewed per run
      enrich_timeout: 30  # seconds to wait for a review
      max_description_words: 2000  # words of each posting the AI reads; pay is often near the end
      backfill_cooldown: "24h"  # `jobs backfill --force-update` skips jobs reviewed this recently
      detail_delay_seconds: 0.5  # pause between job detail downloads
      # Your own questions, answered for each job.
      # criteria:
      #   - label: Sponsorship
      #     assess: "Does the role offer visa sponsorship?"

    # How `jobs verify` checks that saved jobs are still open.
    verify:
      reverify_days: 7  # check the link of a job again after this many days
      unverified_age_days: 30  # close jobs with no link to check (Indeed, Hacker News) after this many days

    # When `jobs run` and `jobs discover-boards` run in the background.
    # `jobs discover-boards` checks the company lists of the job-board-aggregator
    # project (github.com/Feashliaa/job-board-aggregator) for Greenhouse, Ashby,
    # and Lever boards with jobs for your roles, and adds them to the search.
    # Run `daily-driver scheduler install` after a change.
    scheduler:
      run:
        enabled: true
        time: "07:00"
        days: daily  # daily, weekdays, or a list such as [mon, wed, fri]
      discovery:
        enabled: true
        time: "23:59"
        days: [sat, tue]

    # Sites to search. Remove the "# " from the sites you want.
    # These are the only sites job search supports right now.

    # sources:
    #   linkedin:
    #     enabled: true
    #     max_city_queries: 40  # most city-by-city searches per run
    #   indeed:
    #     enabled: true
    #     max_city_queries: 40
    #     country: USA  # Indeed site for a country that has none of its own
    #   apple: true
    #   hn_who_is_hiring:
    #     enabled: true
    #     hn_max_posts: 500
    #   hn_jobs:
    #     enabled: true
    #     hn_max_posts: 500
    #   remoteok:
    #     enabled: true
    #     remoteok_tags: [devops, kubernetes, aws]
    #   weworkremotely:
    #     enabled: true
    #     wwr_categories: [devops-sysadmin]
    #   greenhouse:
    #     enabled: true
    #     greenhouse_boards: []  # boards.greenhouse.io/<name>
    #     exclude_boards: []
    #   ashby:
    #     enabled: true
    #     ashby_boards: []  # jobs.ashbyhq.com/<name>
    #     exclude_boards: []
    #   lever:
    #     enabled: true
    #     lever_boards: []  # jobs.lever.co/<name>
    #     exclude_boards: []
    #   workable:
    #     enabled: true
    #     workable_accounts: []  # apply.workable.com/<name>
    #   workday:
    #     enabled: true
    #     workday_boards:  # from acme.wd5.myworkdayjobs.com/careers
    #       - tenant: acme
    #         host: wd5
    #         site: careers
    #         company: "Acme"
{% endif %}
{% endif %}
