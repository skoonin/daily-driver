# daily-driver workspace configuration
#
# Prose about you lives in context.md and voice-profile.md.
# An unknown or misspelled key is an error.
# To use a commented block, uncomment its header and every line under it.

# Required: workspace settings.
daily_driver:
  # Where the tracker, notes and other output go. Relative to here.
  output_dir: .

# Optional: about you, for Claude prompts.
# user_profile:
#   name: ""
{% if "job_search" in plugins %}
#   citizenship: []  # ["US", "CA"]
{% endif %}
{% if "job_search" in plugins %}
#   work_auth: {}  # {"US": "citizen", "CA": "PR"}
{% endif %}
#   timezone: ""  # "America/Vancouver"
{% if "job_search" in plugins %}
#   seeking_since: 2026-04-06  # YYYY-MM-DD when active job search began
{% endif %}

# Required: tracker settings.
tracker:
  default_category: task
  # Warn when --status is not a usual one for its category (usually
  # open, in-progress, blocked, done, ruled-out). It still saves.
  # warn_unknown_status: true
  # More statuses that do not warn.
  # extra_statuses: [waiting, snoozed]
  # More statuses that close an entry, added to done, ruled-out,
  # dropped, rejected and closed. Closed entries get no follow-ups.
  # terminal_statuses: [cancelled]
  categories:
    task:
      required: [title]
    # More categories. `required` lists the fields `tracker add` needs.
    # errand:
    #   required: [title]
    # ticket:
    #   required: [title, link]

# Optional: repeating tasks, as context for Claude sessions.
# recurring_tasks:
#   - name: "Review tracker follow-ups"
#     cadence: daily            # daily | weekly | monthly
#     estimated_minutes: 10
#   - name: "Weekly retro"
#     cadence: weekly
#     day: friday            # only valid when cadence is weekly

# Optional: background runs set up by `scheduler install`. day-start
# and day-end times are in `schedule:` below.
# Times are HH:MM; `days` is "daily" (default), "weekdays" or a list.
# scheduler:
#   checkin:
#     times:
#       - "11:00"
#       - "15:00"
#     days: "weekdays"
{% if "job_search" in plugins %}
#
#   jobs:
#     time: "07:00"
#     days: [sun, wed]
{% endif %}
{% if "job_search" in plugins %}
#
#   discovery:
#     time: "23:59"
#     days: [sat, tue]
{% endif %}

# Optional: day-start and day-end times (HH:MM) for scheduled runs.
# A day-start over 2 hours after `day_start` is a late start.
# schedule:
#   day_start: "08:00"
#   day_end: "17:30"
#   days: "weekdays"

# Optional: Claude session behavior.
# claude:
#   # true makes `check-in` reopen the latest Claude session.
#   resume_check_in: false

# Optional: AI provider and model per task. Leave out to use Claude.
# ai:
#   # Default provider for every task: claude or ollama.
#   provider: claude
#   # Default model. It must suit the provider (claude: "sonnet";
#   # ollama: a tag like "qwen2.5:14b").
#   # model: sonnet
#
#   # The `summary` task.
#   summary:
#     # claude or ollama. Unset uses `ai.provider`.
#     provider: claude
#     # Model for this task. Unset uses `ai.model`, so set it when
#     # `ai.model` is set and this task uses the other provider.
#     # model: sonnet
#
#   # The `voice-update` task.
#   voice_update:
#     # claude or ollama. Unset uses `ai.provider`.
#     provider: claude
#     # Model for this task. Unset uses `ai.model`, so set it when
#     # `ai.model` is set and this task uses the other provider.
#     # model: sonnet
#
#   # day-start, check-in and day-end. They always use Claude;
#   # `--model` overrides this.
#   interactive:
#     # sonnet, haiku or opus. Unset uses the claude CLI default.
#     model: sonnet
{% if "job_search" in plugins %}
#
#   # Used when a task runs on claude.
#   claude:
#     # Job search enrichment calls at once. 1 runs them one at a time.
#     max_parallel: 4
{% endif %}
#
#   # Used when a task runs on ollama.
#   ollama:
#     endpoint: "http://localhost:11434"
#     # Seconds per call. Ollama is slower than the Claude API.
#     timeout: 60
{% if "job_search" in plugins %}
#     # Job search enrichment calls at once. 1 runs them one at a time.
#     max_parallel: 4
{% endif %}

# Optional: focus mode.
# focus:
#   # Length of `focus on` without `--for` ("25m", "1h", "90m").
#   default_duration: "25m"

# Optional: what `daily-driver gather` reads.
# gather:
#   git:
#     # Folders that hold your git checkouts.
#     search_paths:
#       - "~/git"

# Optional: copy plan time blocks to a macOS Calendar (`calendar sync`).
# calendar:
#   # false makes `calendar sync` do nothing.
#   sync_enabled: false
#   # Calendar to write to. It must already exist.
#   plan_calendar_name: "Daily Plan"
{% if plugins %}

# Plugins. Uncomment an option to change its default.
plugins:
{% if "job_search" in plugins %}
