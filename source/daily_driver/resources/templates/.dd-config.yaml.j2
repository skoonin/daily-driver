#       # Words ignored in company names when finding duplicates.
#       # Replaces the built-in list (inc, ltd, gmbh, labs, ...).
#       company_noise_words: []  # ["inc", "ltd", "labs"]
#       # Seconds per source request.
#       timeout: 30
#       # Search terms for LinkedIn, Indeed and Apple. Unset builds them
